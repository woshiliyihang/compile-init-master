package {
    default_applicable_licenses: ["jason_hal_license"],
}

license {
    name: "jason_hal_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE"],
}

aidl_interface {
    name: "android.hardware.jason",
    vendor_available: true,
    srcs: [
        "aidl/android/hardware/jason/IJason.aidl",
    ],
    stability: "vintf",
    owner: "jason",
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
}

cc_binary {
    name: "android.hardware.jason-service",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["default/android.hardware.jason-service.rc"],
    vintf_fragments: ["default/android.hardware.jason-service.xml"],
    srcs: [
        "default/Jason.cpp",
        "default/service.cpp",
    ],
    shared_libs: [
        "android.hardware.jason-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}


cc_binary {
    name: "android.hardware.jason-client",
    vendor: true,
    srcs: [
        "default/JasonClient.cpp",
    ],
    shared_libs: [
        "android.hardware.jason-V1-ndk",
        "libbinder_ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
